#!/bin/bash
# QQ 农场 飞牛原生包：start / stop / status
# 服务只监听 ${TRIM_APPDEST}/app.sock（飞牛统一网关），不监听任何 TCP 端口。

. "$(dirname "$0")/common.sh"

start_app() {
    if is_running; then
        return 0
    fi

    if [ ! -x "${APP_BIN}" ] || [ ! -f "${SERVER_DIR}/bin/worker.js" ]; then
        user_error "应用文件不完整：缺少 ${APP_BIN} 或 worker.js，请重新安装。"
        return 1
    fi

    prepare_dirs
    rotate_log
    rm -f "${SOCKET_PATH}"
    # 旧版 Docker 容器如仍在运行（会继续占用 3007），每次启动都把它停掉
    stop_old_container

    log_msg "Starting QQ 农场 ${TRIM_APPVER} (bin: ${APP_BIN}, user: $(app_user_exists && echo "${APP_USER}" || id -un))"
    cd "${SERVER_DIR}" || return 1

    # setsid：脱离生命周期脚本的进程组，避免脚本退出时被一并结束
    run_as_app env \
        NODE_ENV=production \
        TZ="${TZ:-Asia/Shanghai}" \
        QQ_FARM_SOCKET="${SOCKET_PATH}" \
        QQ_FARM_NO_TCP=1 \
        QQ_FARM_GATEWAY_PREFIX="${GATEWAY_PREFIX}" \
        QQ_FARM_DATA_DIR="${DATA_DIR}" \
        QQ_FARM_ADMIN_ONLY="${QQ_FARM_ADMIN_ONLY:-1}" \
        QQ_FARM_RESOURCE_DIR="${SERVER_DIR}/resources" \
        QQ_FARM_WEB_DIR="${SERVER_DIR}/web/dist" \
        QQ_FARM_WORKER_SCRIPT="${SERVER_DIR}/bin/worker.js" \
        setsid "${APP_BIN}" >> "${LOG_FILE}" 2>&1 < /dev/null &
    local launcher=$!

    # runuser 会 fork 子进程；记录真正的服务进程 PID
    local i pid=""
    for i in $(seq 1 20); do
        pid="$(pgrep -n -f "^${APP_BIN}$" 2>/dev/null)"
        [ -n "${pid}" ] && break
        sleep 0.25
    done
    [ -z "${pid}" ] && pid="${launcher}"
    echo "${pid}" > "${PID_FILE}"

    # 等待 Socket 就绪（最多 20 秒），失败时给出可见错误
    for i in $(seq 1 40); do
        if [ -S "${SOCKET_PATH}" ]; then
            log_msg "started, pid=${pid}, socket=${SOCKET_PATH}"
            warn_port_3007
            return 0
        fi
        if ! check_process "${pid}"; then
            break
        fi
        sleep 0.5
    done
    if check_process "${pid}"; then
        log_msg "WARN: 进程已启动但 20 秒内未创建 Socket，pid=${pid}"
        return 0
    fi
    user_error "QQ 农场启动失败，请查看日志 ${LOG_FILE}"
    rm -f "${PID_FILE}"
    return 1
}

stop_app() {
    local pid
    pid="$(read_pid)"
    if check_process "${pid}"; then
        log_msg "Stopping pid=${pid}"
        kill -TERM "${pid}" 2>/dev/null
        local count=0
        while check_process "${pid}" && [ "${count}" -lt 15 ]; do
            sleep 1
            count=$((count + 1))
        done
        if check_process "${pid}"; then
            log_msg "send KILL to pid=${pid}"
            kill -KILL "${pid}" 2>/dev/null
        fi
    fi
    rm -f "${PID_FILE}" "${SOCKET_PATH}"
    return 0
}

case "$1" in
    start)
        start_app || exit 1
        exit 0
        ;;
    stop)
        stop_app
        exit 0
        ;;
    status)
        if is_running; then
            exit 0
        fi
        exit 3
        ;;
    *)
        exit 1
        ;;
esac
